{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "trailingComma": "es5",
  "tabWidth": 2,
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    ".claude/**",
    "public/**",
    "tools/oxlint/anti-slop/**",
    "src/blog/**",
    "package-lock.json"
  ]
}
